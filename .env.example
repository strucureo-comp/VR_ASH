# Shopify — copy to .env.local and fill in. Never commit .env.local.
#
# No VITE_ prefix on any of these: the Lovable vite config injects every VITE_*
# variable into the client bundle, which would publish them to the browser.

# Storefront API (Admin → Settings → Apps and sales channels → Develop apps → API credentials)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# The *public* Storefront access token (32-char hex). Not the shpat_ private one.
SHOPIFY_STOREFRONT_TOKEN=

# Customer Account API — login, account, order history.
# Admin → Sales channels → Headless → Customer Account API → Application setup.
# SHOPIFY_SHOP_ID is the numeric id in the endpoint URLs shown on that screen.
# The client id is not a secret (the client is public and uses PKCE), but the
# callback URI must be allowlisted on that same screen or authorize will reject.
# Leave blank and the site runs with sign-in disabled.
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Only for a "Confidential" client type. Leave blank for "Public (web app)",
# which authenticates with PKCE alone. Confidential is the documented choice
# when the code exchange happens on the server, as it does here.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2026-07

# Absolute origin used to build OAuth redirect URIs. On Vercel this is inferred.
SITE_ORIGIN=http://localhost:8080

# Signs the session cookie: openssl rand -hex 32
SESSION_SECRET=
